<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

  <LinearLayout
      android:orientation="vertical"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="@dimen/rfid_screen_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.Rfid.SectionTitle"
        android:text="Read tag memory" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/TextAppearance.Rfid.HelperMetaText"
        android:text="Scan a tag to capture EPC, then read memory banks. Access password is optional (8-hex, 32-bit)." />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rfid_section_spacing"
        android:hint="Target EPC (optional)">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/readTagEpcInput"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/readTagScanButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Scan nearest tag" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rfid_section_spacing"
        android:hint="Access password (HEX, optional)">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/readTagAccessPwdInput"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rfid_section_spacing"
        android:hint="Bank (RESERVED / EPC / TID / USER)">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/readTagBankInput"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rfid_section_spacing">

      <com.google.android.material.textfield.TextInputLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:hint="Word ptr">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/readTagWordPtrInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
      </com.google.android.material.textfield.TextInputLayout>

      <View
          android:layout_width="12dp"
          android:layout_height="1dp" />

      <com.google.android.material.textfield.TextInputLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:hint="Word count">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/readTagWordCountInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
      </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/readTagReadButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rfid_section_spacing"
        android:text="Read" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

      <com.google.android.material.button.MaterialButton
          android:id="@+id/readTagLockButton"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Lock" />

      <View
          android:layout_width="12dp"
          android:layout_height="1dp" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/readTagUnlockButton"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Unlock" />
    </LinearLayout>

    <TextView
        android:id="@+id/readTagStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        style="@style/TextAppearance.Rfid.HelperMetaText"
        android:text="—" />

    <TextView
        android:id="@+id/readTagResultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        style="@style/TextAppearance.Rfid.BodyText"
        android:text="—" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>

